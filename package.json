    "clsx": "^2.1.1",
    "dotted-map": "^3.1.0",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.23",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.42.2",
    "react": "^19.2.6",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.6",
    "react-globe.gl": "^2.38.0",
    "react-leaflet": "^5.0.0",
