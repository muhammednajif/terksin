{
  "name": "trailsync",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "cd server && node --watch index.js",
    "start": "concurrently -n \"vite,server\" -c \"cyan,green\" \"npm run dev -- --port 8080 --host 0.0.0.0\" \"npm run dev:server\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
